{
  "name": "@khazii/ngx-intl-tel-input",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "build_stats": "ng build --stats-json",
    "analyze": "webpack-bundle-analyzer dist/@khazii/ngx-intl-tel-input-app/stats.json",
    "build_lib": "ng build ngx-intl-tel-input",
    "copy-license": "cp ./LICENSE ./dist/@khazii/ngx-intl-tel-input",
    "copy-readme": "cp ./README.md ./dist/@khazii/ngx-intl-tel-input",
    "copy-files": "npm run copy-license && npm run copy-readme",
    "npm_pack": "npm run copy-files && cd dist/ngx-intl-tel-input && npm pack",
    "package": "npm run build_lib && npm run npm_pack"
  },
  "private": true,
  "dependencies": {
    "bootstrap": "^5.3.3",
    "core-js": "^3.38.1",
    "google-libphonenumber": "^3.2.38",
    "intl-tel-input": "^24.5.0",
    "jquery": "^3.7.1",
    "ngx-bootstrap": "^18.0.2",
    "popper.js": "^1.16.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.7.0",
    "zone.js": "~0.14.8"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@angular/language-service": "^17.0.0",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/jasmine": "~5.1.4",
    "@types/jasminewd2": "~2.0.13",
    "@types/node": "^22.5.5",
    "ajv": "^8.17.1",
    "eslint": "^9.10.0",
    "jasmine-core": "~5.3.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^17.0.0",
    "prettier": "^3.3.3",
    "protractor": "^7.0.0",
    "rollup": "^4.21.3",
    "ts-node": "~10.9.2",
    "tslint": "~6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "peerDependencies": {
    "@angular/common": ">=8.0.0 <19.0.0",
    "@angular/core": ">=8.0.0 <19.0.0",
    "@angular/forms": ">=8.0.0 <19.0.0"
  }
}
